        <description>On demand script forfunction to validate address accros all the application scopes</description>
        <mobile_callable>false</mobile_callable>
        <name>validateEmailAddress</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function validateEmailAddress(emailStr) {
	if(typeof emailStr != 'string') {
		gs.error("the address filled is not string");
		return false;
	} else {
		if(emailStr.match(/^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/)) {
			return true;
		} else {
			return false;
		}
	}
}]]></script>
